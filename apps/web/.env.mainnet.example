# ─────────────────────────────────────────────────────────────────────────
#  COMMITCLASH — MAINNET frontend env vars
#  Copy to .env.production (or paste into Vercel project env settings) and
#  fill the 4 unknowns marked TODO before promoting prod.
# ─────────────────────────────────────────────────────────────────────────

# Solana cluster
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet
# Use a paid tier (Helius / Triton / QuickNode). Free RPCs will rate-limit
# your users hard at any meaningful traffic. ~$49/mo Helius is the floor.
NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=TODO

# Program ID — printed by `anchor deploy` and by scripts/prep-mainnet.sh
NEXT_PUBLIC_PROGRAM_ID=TODO_program_id_after_anchor_deploy

# $RPS mint — the address pump.fun gives you when you create the token
NEXT_PUBLIC_RPS_MINT=TODO_pump_fun_mint_address

# Treasury for the 7.5% RPS cut. Must be an ATA (token account) of $RPS,
# owned by whichever wallet you control treasury from.
NEXT_PUBLIC_TREASURY=TODO_treasury_ata

# SOL parallel world — wallet pubkeys (NOT ATAs)
NEXT_PUBLIC_SOL_TREASURY=TODO_sol_treasury_wallet
NEXT_PUBLIC_SOL_BURN_WALLET=TODO_sol_burn_wallet

# Live presence + rate limiting — already mainnet-safe, no change from devnet
NEXT_PUBLIC_ABLY_KEY=qbKjVQ.GDHjxQ:kZA9k2ILCljiKc2Io_BO0WGKuGsHdwAiDNw02J-0qO4
UPSTASH_REDIS_REST_URL=https://deep-quagga-112548.upstash.io
